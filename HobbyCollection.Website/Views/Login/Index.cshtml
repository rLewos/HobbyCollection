@model HobbyCollection.Website.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<form method="post" asp-controller="Login" asp-action="Login">
    <label asp-for="Login.userName">Username</label>
    <input type="text" asp-for="Login.userName"/>
    
    <label asp-for="Login.password">Password</label>
    <input type="password" asp-for="Login.password"/>

    <button type="submit">Login</button>
    <button type="reset">Cancel</button>
</form>

@section Scripts{
    <script language="JavaScript">
        $(() =>{
            
        })
    </script>
}